# Telegram Bot (required — startup aborts without these)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Train data: pick Option A or Option B ─────────────────────────────────────
#
# Option A — HAFAS stboard [recommended]. Real-time, includes delays, NO API KEY.
#
#   Any non-empty value switches the bot to this source. The value itself is
#   never read: OpenDataTrainSource ignores it and calls the hardcoded
#   stboard.exe endpoint directly (see services/trains_opendata.py). It is a
#   feature flag, not a URL — do not go hunting for an access key.
OPEN_DATA_API=stboard

# Option B — static GTFS zip + GTFS-RT for delays. Used only when OPEN_DATA_API
# is empty. Leave GTFS_URL unset to use the live feed
# (http://openov.lu/data/gtfs/gtfs-openov-lu.zip).
#
#   WARNING: do not point this at a dated zip unless the feed covers today.
#   A feed whose calendar.txt range has passed yields an empty train list
#   silently — no error, just "No TGV in schedule today".
# GTFS_URL=

# Real-time delays, Option B only. Default: OpenOV GTFS-RT, refresh every 10 min.
# Requires gtfs-realtime-bindings (in requirements.txt).
# GTFS_RT_URL=
# REALTIME_REFRESH_SECONDS=600

# Auto-report interval in hours (0 to disable). Sends the "Arrives soon" view.
REPORT_INTERVAL_HOURS=3

# DEBUG on first run: logs cache sizes, per-source failures, and the stboard
# delayed-arrival count — the fastest way to tell whether delays are arriving.
LOG_LEVEL=INFO
